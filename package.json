{
	"name": "@index84/revelar",
	"version": "0.1.0",
	"description": "Static, photo-first gallery: drop folders of photos in, get a fast site out",
	"private": false,
	"license": "MIT",
	"homepage": "https://tools.index84.com/revelar/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/keoshi/revelar.git"
	},
	"bugs": {
		"url": "https://github.com/keoshi/revelar/issues"
	},
	"keywords": [
		"photos",
		"gallery",
		"static-site",
		"sveltekit",
		"photography",
		"avif",
		"photoswipe"
	],
	"type": "module",
	"bin": {
		"revelar": "./bin/revelar.js"
	},
	"exports": {
		".": "./src/index.ts",
		"./config": "./src/lib/config.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"src",
		"static/_headers",
		"vite.config.ts",
		"tsconfig.json"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"workspaces": [
		"app"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"revelar": "tsx src/cli/index.ts",
		"ingest": "tsx src/cli/index.ts ingest",
		"dev": "tsx src/cli/index.ts dev",
		"build": "tsx src/cli/index.ts build",
		"build:site": "tsx src/cli/index.ts build --no-ingest",
		"preview": "tsx src/cli/index.ts preview",
		"share": "tsx src/cli/index.ts share",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:unit": "vitest",
		"test:e2e": "playwright test",
		"lighthouse": "npx --yes @lhci/cli@latest autorun",
		"prepublishOnly": "npm run lint && npm run check && npm run test"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@noble/hashes": "^2.4.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"chokidar": "^5.0.0",
		"client-zip": "^2.5.1",
		"exifr": "^7.1.3",
		"justified-layout": "^4.1.0",
		"maplibre-gl": "^6.14.0",
		"marked": "^18.1.1",
		"p-limit": "^7.3.3",
		"photoswipe": "^5.4.4",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"thumbhash": "^0.1.1",
		"tsx": "^4.23.15",
		"valibot": "^1.5.0",
		"vite": "^8.3.0",
		"yaml": "^2.9.1",
		"yazl": "^3.3.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@types/geojson": "^7946.0.16",
		"@types/justified-layout": "^4.1.4",
		"@types/node": "^24",
		"@types/yazl": "^3.3.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
